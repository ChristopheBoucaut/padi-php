{
    "name": "christopheboucaut/padi",
    "description": "A mini library for my personal project to implement design patterns, small utilities to have a clean archi, etc.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Padi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padi\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Christophe Boucaut"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.0.5"
    },
    "require": {
        "psr/event-dispatcher": "^1.0"
    }
}
